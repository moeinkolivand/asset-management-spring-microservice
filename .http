### Login Request
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "phoneNumber": "09332823620",
  "password": "12345"
}

> {%
    let token = response.body.token;
    client.global.set("auth_token", token);

    // ✅ This will print the token in the IntelliJ run console
    console.log("✅ Token extracted successfully: " + token);
    // Alternative:
    // client.log("Token: " + token);
%}

### Withdraw Request - Uses the dynamic token
POST http://localhost:8080/api/transaction/withdraw
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "currencyId": 1,
  "amount": 100,
  "idempotencyKey": "{{$uuid}}",
  "transactionTransferType": "1"
}

###
GET http://localhost:8080/api/transaction/
Authorization: Bearer {{auth_token}}
